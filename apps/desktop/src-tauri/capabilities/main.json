{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the bundled main window may operate its own terminal sessions.",
  "windows": ["main"],
  "permissions": [
    "allow-bootstrap", "allow-prepare-session", "allow-start-session", "allow-input", "allow-reserve-input",
    "allow-output-consumed", "allow-resize-session", "allow-close-session", "allow-view-failed",
    "allow-forget-session", "allow-list-sessions", "allow-load-config", "allow-save-config",
    "allow-save-terminal", "allow-save-workspace", "allow-read-clipboard", "allow-write-clipboard",
    "allow-open-link", "allow-diagnostics"
  ]
}
